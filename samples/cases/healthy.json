    {
      "id": "unit_scale",
      "title": "Unit change",
      "fired": false,
      "summary": "Median payment amount per gateway is within the usual range everywhere.",
      "engine": "sql",
      "blamed": {
        "table": "RAW.PAYMENTS",
        "column": "AMOUNT"
      },
      "level": "value",
      "slice": {},
      "slice_text": "whole batch",
      "metrics": {},
      "sql": "SELECT p.GATEWAY, p.CURRENCY_CODE,\n  MEDIAN(CASE WHEN p.BATCH_DAY = DATE '2026-10-20' THEN p.AMOUNT END) AS MED_TODAY,\n  MEDIAN(CASE WHEN p.BATCH_DAY < DATE '2026-10-20' THEN p.AMOUNT END) AS MED_BASE,\n  SUM(CASE WHEN p.BATCH_DAY = DATE '2026-10-20' THEN 1 ELSE 0 END) AS N_TODAY\nFROM RAW.PAYMENTS p\nWHERE p.BATCH_DAY >= CAST(DATE '2026-10-20' + CAST(-14 AS INTEGER) AS DATE) AND p.BATCH_DAY <= DATE '2026-10-20' AND p.PAY_STATUS = 'CAPTURED'\nGROUP BY p.GATEWAY, p.CURRENCY_CODE\nORDER BY p.GATEWAY, p.CURRENCY_CODE",
      "ms": 19.0,
      "outcome": "NOT_FIRED",

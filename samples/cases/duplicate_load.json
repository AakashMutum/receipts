  "fix_diff": "--- pipeline.sql (production)\n+++ pipeline.sql (proven by the undo test)\n@@ -15,5 +15,35 @@\n   (p.CAPTURED_AT + to_minutes(CAST(330 AS BIGINT))) AS CAPTURED_AT_IST,\n   CAST((p.CAPTURED_AT + to_minutes(CAST(330 AS BIGINT))) AS DATE) AS TXN_DAY\n-FROM RAW.PAYMENTS p\n+FROM (\n+  SELECT\n+    PAYMENT_ID,\n+    ORDER_ID,\n+    BATCH_DAY,\n+    LOAD_FILE,\n+    GATEWAY,\n+    CURRENCY_CODE,\n+    AMOUNT,\n+    PAY_STATUS,\n+    CAPTURED_AT\n+  FROM RAW.PAYMENTS\n+  WHERE BATCH_DAY <> DATE '2026-10-20'\n+  UNION ALL\n+  SELECT\n+    PAYMENT_ID,\n+    ORDER_ID,\n+    BATCH_DAY,\n+    LOAD_FILE,\n+    GATEWAY,\n+    CURRENCY_CODE,\n+    AMOUNT,\n+    PAY_STATUS,\n+    CAPTURED_AT\n+  FROM (\n+    SELECT i.*, ROW_NUMBER() OVER (PARTITION BY i.PAYMENT_ID ORDER BY i.LOAD_FILE DESC, i.CAPTURED_AT DESC) AS RN\n+    FROM RAW.PAYMENTS i\n+    WHERE i.BATCH_DAY = DATE '2026-10-20'\n+  ) z\n+  WHERE z.RN = 1\n+) p\n WHERE p.PAY_STATUS = 'CAPTURED';\n \n",
